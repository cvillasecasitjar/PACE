{
  "expo": {
    "name": "Pace",
    "slug": "pace",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pace",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#0B1020",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pace.mobile"
    },
    "android": {
      "package": "app.pace.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
